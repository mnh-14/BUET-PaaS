MONGO_URI=mongodb://localhost:27017
MONGO_DB=buetpaas

SONAR_ENABLED=true
SONAR_HOST_URL=http://192.168.67.252:9000
SONAR_TOKEN=
SONAR_SCANNER_BIN=sonar-scanner
SONAR_SCAN_TIMEOUT=300

GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_CALLBACK_URL=
GITHUB_INSTALL_URL=
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=

# ── Per-User Databases (provisioned on the k3s cluster via the deployer) ──
# DEPLOYER_URL must point at the deployer Flask service (in-cluster or control VM).
DEPLOYER_URL=http://192.168.68.121:5000
# How student apps are hosted: "docker" (current default) or "k3s".
# docker → databases are exposed on a NodePort so the Docker app can reach them.
# k3s    → apps run in-cluster; databases use the internal cluster DNS only.
APP_RUNTIME=docker
DATABASE_PROVISIONING_ENABLED=true
DATABASE_ALLOWED_ENGINES=postgres,mongodb,redis
DATABASE_ALLOWED_SIZES_GB=1,5
DATABASE_DEFAULT_SIZE_GB=1
DATABASE_MAX_PER_USER=2
DATABASE_MAX_PER_PROJECT=1
DATABASE_STORAGE_CLASS=local-path
# Worker node IP that hosts the NodePort for docker-runtime apps.
DATABASE_EXTERNAL_HOST=192.168.68.121
# Optional credit charge per provisioned database (0 disables charging).
DATABASE_COST_CREDITS=0
